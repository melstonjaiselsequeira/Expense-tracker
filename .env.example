# Application Secret Key for session signing and tokens
SECRET_KEY=your_secret_key_hex_here

# Database Configuration
# For SQLite (default):
# SQLALCHEMY_DATABASE_URI=sqlite:///expenses.db

# For PostgreSQL (Local):
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/expenseflow
# or:
SQLALCHEMY_DATABASE_URI=postgresql://postgres:your_password@localhost:5432/expenseflow

# For PostgreSQL (Cloud - Neon / Supabase / Render / Railway / RDS):
# DATABASE_URL=postgresql://user:password@ep-sample-12345.region.aws.neon.tech/expenseflow?sslmode=require

# Flask Environment
FLASK_APP=app.py
FLASK_ENV=production

# Rate Limiting
RATELIMIT_ENABLED=True

# SMTP Mail Settings for Email Verification & Password Reset
# For Gmail, use smtp.gmail.com with a 16-character Google App Password:
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
